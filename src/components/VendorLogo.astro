---
/**
 * Somebody else's own mark, monochrome.
 *
 * The paths are transcribed in `src/landing/vendor-marks.ts`, which records
 * where they came from and on what licence. `currentColor` is the whole point of
 * drawing them monochrome: the Token layer stays the only place a colour is
 * chosen, the marks read in both themes, and a wall of vendor colours never
 * competes with the page's own.
 */
import type { VendorMark } from '../landing/vendor-marks';

interface Props {
  readonly mark: VendorMark;
  readonly size?: number;
}

const { mark, size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  fill-rule="evenodd"
  aria-hidden="true"
  focusable="false"
>
  {(mark.paths ?? []).map((path) => <path d={path}></path>)}
</svg>
