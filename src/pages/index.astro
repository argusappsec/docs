---
/**
 * The Landing. Its reader has never heard of Argus, so the page has one job:
 * make the Argument — scanners are precise but shallow, a model alone drowns the
 * signal, and the organization is the missing third ingredient — and hand off.
 *
 * It restates the Argument in its own words, because an argument does not go
 * stale. It restates no Inventory: the scanners, the built-in skills, the
 * channels and the quick-start commands are all things that change as Argus
 * changes, and every one of them is reached by a link instead. The list of Guide
 * pages is read from the Mirror's frontmatter — see `src/landing/handoff.ts` for
 * why frontmatter and never prose.
 *
 * Two things carry the design. The mark is an ocellus, the eye in a peacock's
 * feather, which is where the myth put the hundred eyes of Argus: so the hero
 * sits inside faint concentric rings that dilate like an iris. And the review
 * card is the product's most characteristic moment — a finding you can answer
 * back. Everything else is quiet on purpose.
 *
 * The copy is short by instruction. Where a sentence could be two, it is one.
 *
 * This is a plain Astro page, outside Starlight's layout, which is why it
 * carries its own document head, its own theme resolution (ADR 0007) and its own
 * reset. All of its colour comes from the Tokens; none of it is a literal.
 */
import { getCollection } from 'astro:content';

import Mark from '../assets/brand/argus.svg';
import { GUIDE_ROOT, guideHandoff } from '../landing/handoff';
import '../styles/global.css';

const { overview, pages } = guideHandoff(await getCollection('docs'));

/** The Mirror's front page carries its own title and description, so it is
 *  preferred; `GUIDE_ROOT` covers the type's other case and points at the same
 *  URL. Neither is better than the Mirror underneath it. */
const guideHref = overview?.href ?? GUIDE_ROOT;

const REPOSITORY = 'https://github.com/argusappsec/argus';
const SECURITY_CONTACT = 'security@argusappsec.com';

const TITLE = 'Argus — an application security agent you can argue with';
const DESCRIPTION =
  'Argus is an open-source application security agent. It reviews your code, ' +
  'tells you what matters, and defends its findings when you disagree.';

/**
 * The review, as an illustration. Every part of it is behaviour the Guide
 * documents: a review arrives on a pull request, and the way to talk to Argus is
 * its bare name opening the comment, which is why the reply reads exactly like
 * this. Generic on purpose — no repository, no org, nothing that could be read
 * as a record of a real review.
 */
const REVIEW = {
  where: 'pull request',
  /** Separate from its label, and a number rather than part of the string: a
   *  hash followed by three digits is also a valid hex colour, and the Palette's
   *  budget in `tokens.test.ts` counts every one of those in the repository. */
  number: 128,
  severity: 'high',
  endpoint: 'GET /orders/{id}',
  finding: 'Broken object authorization',
  detail: 'The handler loads the order by id. Nothing checks who owns it.',
  question: 'Argus, is this finding real?',
  answer: 'Yes. The query filters by id only, so any signed-in user can read any order.',
};

/**
 * What a review does, in the order it does it. A sequence, so it is numbered;
 * the three parts of the Argument below are not a sequence, and are not.
 */
const STEPS = [
  {
    title: 'Runs the scanners',
    detail: 'Real scanners, wrapped as structured tools. The model never gets a shell.',
  },
  {
    title: 'Reads the findings',
    detail: 'It works through them instead of forwarding a report nobody opens.',
  },
  {
    title: 'Weighs your context',
    detail: 'Your stack, your risk tolerance, the exceptions you already granted.',
  },
  {
    title: 'Answers back',
    detail: 'Ask why on the thread. The answer arrives where the review did.',
  },
];

/** The Argument. Three ingredients; the third is the one nobody ships. */
const INGREDIENTS = [
  {
    role: 'The scanners',
    title: 'Precise, and blind here',
    detail: 'A missing ownership check has no signature. Nothing in the code looks wrong.',
  },
  {
    role: 'The model',
    title: 'Sharp, and noisy',
    detail: 'Alone with a repository it returns pages of maybes. Nobody triages that.',
  },
  {
    role: 'Your organization',
    title: 'The part that decides',
    detail: 'What counts as risk here depends on what you build and what you already accepted.',
    missing: true,
  },
];

/** ADR 0004 keeps gold out of small type, so the numbers are `primary` on `bg`. */
const SCORE = [
  { figure: '100%', label: 'recall' },
  { figure: '100%', label: 'precision' },
  { figure: 'VAmPI', label: 'benchmark' },
];

const canonical = new URL('/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/argus.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta name="twitter:card" content="summary" />

    {
      /**
       * The one script on the page, and the reason ADR 0007 exists: outside
       * Starlight's layout nothing sets `data-theme`, so without this the
       * Landing is dark for every reader — including one who chose light in the
       * Guide two clicks ago. Inline and in the head, because a theme resolved
       * after first paint is a flash of the wrong colours.
       *
       * Deliberately the same expression as Starlight's own ThemeProvider, on
       * the same storage key: Starlight writes `''` for "auto", so an empty
       * string correctly falls through to the operating system's preference.
       */
    }
    <script is:inline>
      const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
      const theme =
        stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="/">
          <Mark class="mark" width="24" />
          <span>Argus</span>
        </a>

        <nav class="nav" aria-label="Sections of this page">
          <a href="#how">How it works</a>
          <a href="#case">The case</a>
          <a href="#verified">Verified</a>
        </nav>

        <div class="topbar-end">
          <a class="nav-link" href={guideHref}>Guide</a>
          <a class="button button-primary button-sm" href={REPOSITORY}>GitHub</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="section hero">
        <span class="rings" aria-hidden="true"></span>

        <div class="shell hero-inner">
          <p class="badge">
            <span class="badge-dot" aria-hidden="true"></span>
            Open source · Self-hosted · Apache 2.0
          </p>

          <h1 class="hero-title">
            A security review <span class="accented">you can argue with.</span>
          </h1>

          <p class="lede">
            An open-source application security agent. It reviews your code, tells you what matters,
            and defends its findings when you disagree.
          </p>

          <p class="actions">
            <a class="button button-primary" href={guideHref}>Read the Guide</a>
            <a class="button" href={REPOSITORY}>Argus on GitHub</a>
          </p>

          <figure class="review">
            <figcaption class="sr-only">
              An example of a review Argus leaves on a pull request, and its answer when the finding
              is questioned.
            </figcaption>

            <div class="review-head">
              <span class="review-where">
                <Mark class="mark mark-sm" width="15" />
                {REVIEW.where} #{REVIEW.number}
              </span>
              <span class="chip chip-sm">{REVIEW.severity}</span>
            </div>

            <p class="review-title">
              {REVIEW.finding} in <code>{REVIEW.endpoint}</code>
            </p>
            <p class="review-detail">{REVIEW.detail}</p>

            <div class="thread">
              <p class="turn"><span class="who">you</span>{REVIEW.question}</p>
              <p class="turn"><span class="who who-argus">argus</span>{REVIEW.answer}</p>
            </div>
          </figure>
        </div>
      </section>

      <section class="section" id="how" aria-labelledby="how-heading">
        <div class="shell">
          <p class="eyebrow reveal">How it works</p>
          <h2 class="heading reveal" id="how-heading">A review, then a conversation.</h2>

          <ol class="steps">
            {
              STEPS.map((step, index) => (
                <li class="step reveal">
                  <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-body">{step.detail}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="section section-raised" id="case" aria-labelledby="case-heading">
        <div class="shell">
          <p class="eyebrow reveal">The case</p>
          <h2 class="heading reveal" id="case-heading">
            Scanners go blind. Models get noisy. Your context decides.
          </h2>

          <ul class="ingredients">
            {
              INGREDIENTS.map((ingredient) => (
                <li class:list={['card', 'ingredient', { 'ingredient-missing': ingredient.missing }]}>
                  <p class="role">{ingredient.role}</p>
                  <h3 class="card-title">{ingredient.title}</h3>
                  <p class="card-body">{ingredient.detail}</p>
                </li>
              ))
            }
          </ul>

          <hr class="rule reveal" />
          <p class="closing reveal">Take one away and you get a tool people learn to ignore.</p>
        </div>
      </section>

      <section class="section" id="verified" aria-labelledby="verified-heading">
        <div class="shell">
          <p class="eyebrow reveal">Verified</p>
          <h2 class="heading reveal" id="verified-heading">One claim, and you can check it.</h2>

          <ul class="score">
            {
              SCORE.map(({ figure, label }) => (
                <li class="tile reveal">
                  <p class="tile-figure">{figure}</p>
                  <p class="tile-label">{label}</p>
                </li>
              ))
            }
          </ul>

          <div class="prose reveal">
            <p>
              Argus runs an authorization audit against VAmPI, a deliberately vulnerable API. It
              found every broken-authorization flaw in it and reported nothing that was not there.
            </p>
            <p><a href="/guide/skills/">How skills work</a></p>
          </div>
        </div>
      </section>

      <section class="section" id="model" aria-labelledby="model-heading">
        <div class="shell">
          <p class="eyebrow reveal">Your model</p>
          <h2 class="heading reveal" id="model-heading">Bring your own model.</h2>

          <div class="prose reveal">
            <p>
              A provider type names a protocol, not a vendor. Any server that speaks it is a
              candidate, hosted or running on hardware you own.
            </p>
            <p class="claim">Run the model locally and your code never leaves your infrastructure.</p>
            <p><a href="/guide/llm-providers/">What Argus needs from a model</a></p>
          </div>
        </div>
      </section>

      <section class="section section-raised" id="guide" aria-labelledby="guide-heading">
        <div class="shell">
          <p class="eyebrow reveal">The Guide</p>
          <h2 class="heading reveal" id="guide-heading">Everything you have to run.</h2>

          <ul class="guide-pages">
            {
              pages.map((page) => (
                <li class="reveal">
                  <a class="card guide-page" href={page.href}>
                    <h3 class="card-title">{page.title}</h3>
                    {page.description && <p class="card-body">{page.description}</p>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell footer-inner">
        <p class="footer-brand">
          <Mark class="mark" width="20" />
          The Guide is written in the Argus repository and published here.
        </p>
        <p class="footer-links">
          <a href={guideHref}>Guide</a>
          <a href={REPOSITORY}>GitHub</a>
          <a href={`mailto:${SECURITY_CONTACT}`}>Report a vulnerability</a>
        </p>
      </div>
    </footer>

    <style>
      /*
       * Starlight's reset ships only on Starlight's own routes, and
       * `@astrojs/starlight-tailwind` restores just borders and font families
       * for pages like this one. So the Landing brings the little else it needs
       * rather than pulling in Tailwind's full preflight, which Starlight's
       * stylesheet is not written to sit under.
       */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-size: 1.0625rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3,
      p,
      ul,
      ol,
      figure {
        margin: 0;
      }

      ul,
      ol {
        padding: 0;
        list-style: none;
      }

      a {
        color: inherit;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }

      :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skip {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        z-index: 2;
        padding: 0.5rem 0.85rem;
        border-radius: 0.5rem;
        background-color: var(--color-primary);
        color: var(--color-bg);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-250%);
      }

      .skip:focus-visible {
        transform: none;
      }

      /* Layout ---------------------------------------------------------------
       *
       * One shell, one section rhythm. Both are declared once and never
       * re-declared per section: a section modifier may add a background, never
       * a padding, so no two rules in here ever argue about spacing.
       */

      .shell {
        width: 100%;
        max-width: 68rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      }

      .section {
        padding-block: clamp(3.25rem, 7vw, 5.25rem);
        /* The bar is sticky, so an anchor has to stop below it. */
        scroll-margin-top: 4rem;
      }

      .section-raised {
        background-color: var(--color-surface);
        border-block: 1px solid var(--color-border);
      }

      /* Type ----------------------------------------------------------------
       *
       * No brand typeface, deliberately and out of scope, so the page borrows
       * the two voices the brand already has: the banner's heavy tightly
       * tracked wordmark for anything that speaks, and the mono face for
       * anything that labels. A label is a label, a heading is a heading, and
       * they never dress as each other.
       */

      .eyebrow,
      .nav a,
      .badge,
      .role,
      .step-number,
      .tile-label,
      .review-where,
      .thread {
        font-family: var(--font-mono);
      }

      /*
       * Muted, not `primary`, and the reason is a measurement: two of the five
       * sections stand on `surface`, where verdigris measures 4.31 and fails AA
       * for type this small. `text-muted` reads 5.51 on `bg` and 5.67 on
       * `surface`, so one rule is safe wherever a section puts it. The colour
       * goes where the ground is always `bg`: the headline's second clause, the
       * step numbers, the figures, the links.
       */
      .eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      .heading {
        margin-block: 0.85rem 2.25rem;
        max-width: 30ch;
        font-size: clamp(1.6rem, 3.2vw, 2.25rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.12;
        text-wrap: balance;
      }

      .prose {
        display: grid;
        gap: 1rem;
        max-width: 36rem;
      }

      .prose a,
      .footer a {
        color: var(--color-primary);
      }

      .prose a,
      .footer a,
      .nav a,
      .nav-link {
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        transition: color 0.2s ease;
      }

      .prose a:hover,
      .footer a:hover {
        text-decoration-thickness: 2px;
      }

      /* The bar -------------------------------------------------------------
       *
       * Sticky, and translucent so the rings keep moving underneath it. The
       * section links disappear on a narrow screen: a hamburger is a script,
       * and the page is short enough to scroll.
       */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border);
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1.0625rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-decoration: none;
      }

      .mark {
        display: block;
        height: auto;
      }

      .nav {
        display: none;
        gap: 1.5rem;
        font-size: 0.8125rem;
      }

      .nav a,
      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
      }

      .nav a:hover,
      .nav-link:hover {
        color: var(--color-text);
      }

      .nav-link {
        font-size: 0.875rem;
        font-weight: 600;
      }

      .topbar-end {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      @media (min-width: 52rem) {
        .nav {
          display: flex;
        }
      }

      /* Hero ----------------------------------------------------------------
       *
       * The rings are the page's atmosphere: concentric hairlines centred where
       * the eye of the mark would be, dilating like an iris. They are drawn in
       * CSS rather than taken from the artwork, so a redrawn mark cannot break
       * them, and they are masked to nothing before they reach the edges so the
       * pattern never reads as a grid.
       */

      .hero {
        position: relative;
        overflow-x: clip;
        padding-top: clamp(2.5rem, 6vw, 4.5rem);
        text-align: center;
      }

      .rings {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-radial-gradient(
          circle at 50% 30%,
          color-mix(in srgb, var(--color-accent) 26%, transparent) 0 1.5px,
          transparent 1.5px 74px
        );
        mask-image: radial-gradient(circle at 50% 30%, black 8%, transparent 62%);
        transform-origin: 50% 30%;
      }

      .hero-inner {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 1.35rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.8rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
        color: var(--color-text-muted);
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* The one gold dot on the page: the eye, at label size. */
      .badge-dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background-color: var(--color-accent);
      }

      .hero-title {
        max-width: 20ch;
        font-size: clamp(2.4rem, 6.4vw, 4.25rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1;
        text-wrap: balance;
      }

      /* `primary` on `bg`, which is a pair the build asserts: 5.68 on paper,
         4.95 on night. The claim gets the colour, not the whole headline. */
      .accented {
        color: var(--color-primary);
      }

      .lede {
        max-width: 38rem;
        font-size: clamp(1.0625rem, 2vw, 1.1875rem);
        color: var(--color-text-muted);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      /* Buttons -------------------------------------------------------------
       *
       * The filled one is `bg` over `primary`, one of the pairs ADR 0004
       * measured and the build asserts, so the loudest element on the page is
       * also one of the checked ones.
       */

      .button {
        display: inline-block;
        padding: 0.7rem 1.2rem;
        border: 1px solid var(--color-border);
        border-radius: 0.6rem;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        transition:
          border-color 0.2s ease,
          background-color 0.2s ease,
          color 0.2s ease;
      }

      .button:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      .button-primary {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-bg);
      }

      .button-primary:hover {
        background-color: color-mix(in oklab, var(--color-primary) 88%, var(--color-text));
        border-color: color-mix(in oklab, var(--color-primary) 88%, var(--color-text));
        color: var(--color-bg);
      }

      .button-sm {
        padding: 0.4rem 0.85rem;
        font-size: 0.8125rem;
      }

      /* The review ----------------------------------------------------------
       *
       * The signature of the page, and the only place it raises its voice: the
       * thing Argus does that a report cannot. Nothing here is `primary`,
       * because verdigris on the dark `surface` measures 4.31 and would fail AA
       * for body text; the severity chip carries the colour instead.
       */

      .review {
        width: 100%;
        max-width: 34rem;
        margin-top: 1rem;
        padding: 1.15rem 1.25rem 1.25rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.9rem;
        text-align: left;
        box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--color-bg) 55%, transparent);
      }

      .review-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .review-where {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }

      .mark-sm {
        opacity: 0.85;
      }

      .review-title {
        margin-top: 0.85rem;
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .review-detail {
        margin-top: 0.35rem;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      .thread {
        margin-top: 1rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--color-border);
        display: grid;
        gap: 0.6rem;
        font-size: 0.8125rem;
        line-height: 1.5;
      }

      /* Wide enough for the longer of the two speakers plus its chevron, which is
         `argus ›`. A wrapped speaker label stops reading as a transcript. */
      .turn {
        display: grid;
        grid-template-columns: 4.5rem 1fr;
        gap: 0.5rem;
      }

      .who {
        color: var(--color-text-muted);
        white-space: nowrap;
      }

      .who::after {
        content: ' ›';
      }

      .who-argus {
        color: var(--color-text);
        font-weight: 600;
      }

      /* How it works --------------------------------------------------------
       *
       * Numbered because a review really does happen in this order. The three
       * parts of the Argument below are not an order and carry no numbers.
       */

      .steps {
        display: grid;
        gap: 1.75rem;
      }

      @media (min-width: 46rem) {
        .steps {
          grid-template-columns: repeat(4, 1fr);
          gap: 1.5rem;
        }
      }

      .step {
        padding-top: 0.9rem;
        border-top: 1px solid var(--color-border);
      }

      /* `primary` at label size only holds on `bg`, which is where this section
         stands. Move the steps onto a raised band and the colour has to go. */
      .step-number {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--color-primary);
      }

      .step-title {
        margin-top: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
      }

      .step-body {
        margin-top: 0.35rem;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      /* Cards ---------------------------------------------------------------
       *
       * On the raised band the cards are `bg`: the same two Tokens as
       * everywhere else, swapped, so a card stays visible against the section
       * it sits in without inventing a third neutral. Titles are `text` and
       * bodies are `text-muted`, never `primary`.
       */

      .card {
        display: block;
        padding: 1.35rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.9rem;
        transition:
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .section-raised .card {
        background-color: var(--color-bg);
      }

      .card-title {
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }

      .card-body {
        margin-top: 0.5rem;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      .ingredients {
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 52rem) {
        .ingredients {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .role {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 0.85rem;
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      .role::before {
        content: '';
        flex: none;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background-color: var(--color-text-muted);
      }

      /* The third ingredient is the one nobody ships, so it is the one in gold. */
      .ingredient-missing .role {
        color: var(--color-text);
      }

      .ingredient-missing .role::before {
        background-color: var(--color-accent);
        box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--color-accent) 28%, transparent);
      }

      /*
       * The Token layer already makes an `hr` a gold band, but it only sets the
       * colour and the top width — it is written for Starlight's routes, where
       * Starlight's reset has already cleared the browser's inset border. This
       * page has no such reset, so the border has to be cleared here, and
       * clearing it unlayered takes the Token layer's colour with it. Hence both
       * again: same decision, restated where nothing else survives.
       */
      .rule {
        width: 3.5rem;
        margin: 2.25rem 0 1.1rem;
        border: 0;
        border-top: 2px solid var(--color-accent);
        transform-origin: left center;
      }

      .closing {
        max-width: 32rem;
        font-size: clamp(1.0625rem, 2vw, 1.2rem);
        font-weight: 600;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }

      /* The score -----------------------------------------------------------
       *
       * Tiles on `bg`, which is what lets the figures be `primary`: on the dark
       * `surface` that pair measures 4.31 and would fail.
       */

      .score {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 2rem;
        max-width: 34rem;
      }

      .tile {
        padding: 1rem 1.1rem;
        border: 1px solid var(--color-border);
        border-radius: 0.75rem;
      }

      .tile-figure {
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.03em;
        color: var(--color-primary);
      }

      .tile-label {
        margin-top: 0.15rem;
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      /*
       * Gold as a rule rather than as type: on paper it is unreadable as a
       * foreground at 1.76, and a 2px band is the shape ADR 0004 gives it there.
       */
      .claim {
        padding-left: 1rem;
        border-left: 2px solid var(--color-accent);
        font-size: clamp(1.0625rem, 2vw, 1.15rem);
        font-weight: 600;
      }

      /* The chip is the other gold shape: a fill, with night over it in either
         theme. `text` is night in light and `bg` is night in dark, which is the
         asymmetry `::selection` in the Token layer already follows. */
      .chip {
        display: inline-block;
        padding: 0.45rem 0.9rem;
        border-radius: 0.5rem;
        background-color: var(--color-accent);
        color: var(--color-bg);
        font-weight: 700;
      }

      :root[data-theme='light'] .chip {
        color: var(--color-text);
      }

      .chip-sm {
        padding: 0.1rem 0.5rem;
        border-radius: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
      }

      /* The handoff ---------------------------------------------------------- */

      .guide-pages {
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 40rem) {
        .guide-pages {
          grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
        }
      }

      .guide-page {
        height: 100%;
        text-decoration: none;
      }

      /* Only the cards that are links react to a pointer. The ingredients are
         prose in a box and stay still. */
      .guide-page:hover {
        border-color: var(--color-primary);
        box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--color-text) 10%, transparent);
      }

      .guide-page:hover .card-title {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }

      /* Footer --------------------------------------------------------------- */

      .footer {
        padding-block: 2.25rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 2rem;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      /* Motion --------------------------------------------------------------
       *
       * Every animation lives inside this one query, and the page's resting
       * state is the finished state. So a reader who asks for less motion is not
       * served a blank page, and neither is a browser without scroll-driven
       * animations: they both get the page with nothing moving.
       */

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }

        .hero-inner > * {
          animation: rise 0.7s cubic-bezier(0.22, 0.68, 0.3, 1) both;
        }

        .hero-title {
          animation-delay: 0.08s;
        }

        .lede {
          animation-delay: 0.18s;
        }

        .actions {
          animation-delay: 0.28s;
        }

        /* The card lands last and from further away: it is the one thing on the
           page worth waiting a third of a second for. */
        .review {
          animation:
            settle 0.9s 0.38s cubic-bezier(0.22, 0.68, 0.3, 1) both,
            rise 0s both;
        }

        /* The iris: out once on arrival, then a slow dilation that never
           finishes. Slow enough that it reads as light rather than as movement. */
        .rings {
          animation:
            iris 2.2s cubic-bezier(0.22, 0.68, 0.3, 1) both,
            dilate 19s 2.2s ease-in-out infinite alternate;
        }

        .card {
          transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
        }

        .guide-page:hover {
          transform: translateY(-2px);
        }

        /*
         * Scroll-driven, so each element arrives on its own as it enters —
         * a stagger the page gets from the reader's scrolling rather than from a
         * table of delays. A browser without scroll-driven animations skips the
         * block and shows the page, which is the resting state anyway.
         *
         * Longhands, and not the `animation` shorthand: the build minifies with
         * Lightning CSS, which folds `animation-timeline` into a shorthand in
         * the same rule and emits `animation: 1s linear both rise view()` — and
         * the timeline was removed from that shorthand, so the whole declaration
         * is invalid and dropped. Chrome agrees: `CSS.supports('animation', '1s
         * linear both rise view()')` is false. The symptom is no reveal at all,
         * in every browser, with nothing in the build to say so.
         */
        @supports (animation-timeline: view()) {
          .reveal {
            animation-name: rise;
            animation-duration: 1s;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 6% entry 55%;
          }

          .rule {
            animation-name: draw;
          }
        }
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(1rem);
        }
      }

      @keyframes settle {
        from {
          opacity: 0;
          transform: translateY(2.25rem) scale(0.985);
        }
      }

      @keyframes iris {
        from {
          opacity: 0;
          transform: scale(0.55);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @keyframes dilate {
        to {
          transform: scale(1.07);
        }
      }

      @keyframes draw {
        from {
          transform: scaleX(0);
        }
      }
    </style>
  </body>
</html>
