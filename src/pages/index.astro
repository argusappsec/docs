---
/**
 * The Landing. Its reader has never heard of Argus, so the page has one job:
 * make the Argument — scanners are precise but shallow, a model alone drowns the
 * signal, and the organization is the missing third ingredient — and hand off.
 *
 * It restates the Argument in its own words, because an argument does not go
 * stale. It restates no Inventory: the scanners, the built-in skills, the
 * channels and the quick-start commands are all things that change as Argus
 * changes, and every one of them is reached by a link instead. The list of Guide
 * pages is read from the Mirror's frontmatter — see `src/landing/handoff.ts` for
 * why frontmatter and never prose.
 *
 * Two things carry the design. The mark is an ocellus, the eye in a peacock's
 * feather, which is where the myth put the hundred eyes of Argus: so the hero
 * sits inside faint concentric rings that dilate like an iris, and a ring leaves
 * the centre every few seconds the way an eye sweeps a room. And the page argues
 * by showing rather than telling: a conversation in the hero, and under it one
 * pull request thread that grows across three sections as you scroll — Argus
 * finds a shape, you tell it something no scanner can know, and the severity
 * changes because of you. Everything else is quiet on purpose.
 *
 * The copy is short by instruction. Where a sentence could be two, it is one.
 *
 * This is a plain Astro page, outside Starlight's layout, which is why it
 * carries its own document head, its own theme resolution (ADR 0007) and its own
 * reset. All of its colour comes from the Tokens; none of it is a literal.
 */
import { getCollection } from 'astro:content';

import Mark from '../assets/brand/argus.svg';
import GitHubMark from '../components/GitHubMark.astro';
import VendorLogo from '../components/VendorLogo.astro';
import { GUIDE_ROOT, guideHandoff } from '../landing/handoff';
import { CLIENT_MARKS, PROVIDER_MARKS } from '../landing/vendor-marks';
import '../styles/global.css';

const { overview, pages } = guideHandoff(await getCollection('docs'));

/** The Mirror's front page carries its own title and description, so it is
 *  preferred; `GUIDE_ROOT` covers the type's other case and points at the same
 *  URL. Neither is better than the Mirror underneath it. */
const guideHref = overview?.href ?? GUIDE_ROOT;

const REPOSITORY = 'https://github.com/argusappsec/argus';
const SECURITY_CONTACT = 'security@argusappsec.com';

const TITLE = 'Argus — an application security agent that knows your organization';
const DESCRIPTION =
  'Argus is an open-source application security agent. It reviews your code ' +
  'against your own stack, risk tolerance and exceptions, and answers when you disagree.';

/**
 * The hero's thesis, as a conversation: the finding a scanner cannot reach,
 * because reaching it takes something only this organization knows.
 *
 * Written inside what the Guide documents and no further. SOUL and MEMORY ride
 * along in every model call, which is what lets Argus turn "support agents share
 * one account" into an exploit path, and filing findings is what the agent loop
 * does. Generic on purpose: no repository, no organization, nothing readable as
 * a record of a real review.
 */
const CONVERSATION = [
  { who: 'you', says: 'anything worth my time in payments?' },
  {
    who: 'argus',
    says: 'Yes. Orders load by id with no ownership check. You told me support agents share one service account, so any agent can read any customer’s order.',
  },
  { who: 'you', says: 'that is worse than the scanner said.' },
  { who: 'argus', says: 'The scanner cannot know who your agents are. I filed it high.' },
];

/**
 * The middle of the page is one story, told in three beats, on the surface where
 * it really happens: a pull request thread that grows as you scroll.
 *
 * A story rather than a feature list, because the Argument is a sequence — the
 * scanner finds a shape, you supply what the scanner cannot know, and the
 * severity changes because of you. Three cards saying "it learns from you" would
 * assert that. This shows it.
 *
 * Every beat's panel carries the previous beat's last message, muted, so the
 * thread reads as continuous even though each beat is a separate section.
 *
 * The thread is generic on purpose: no real repository, no real organization,
 * nothing readable as a record of an actual review. The bot's name, the way you
 * address it and the two severities are all things the Guide documents.
 */
const THREAD = { repo: 'payments-api', pr: 128, file: 'internal/orders/handler.go' };

/**
 * The hunk the finding sits on. Short lines on purpose: a phone has to hold them
 * without scrolling sideways.
 */
const CODE = [
  { at: 41, text: 'id := chi.URLParam(r, "id")' },
  { at: 42, text: 'order, err := h.orders.ByID(ctx, id)', flagged: true },
  { at: 43, text: 'if err != nil {' },
  { at: 44, text: '  return err' },
  { at: 45, text: '}' },
  { at: 46, text: 'return writeJSON(w, order)' },
];

/** The one line the thread is attached to, which is what the later beats show:
 *  a review comment on GitHub hangs off a line, and keeping it visible is what
 *  makes three panels read as one pull request rather than three mockups. */
const ANCHOR = CODE.filter((line) => line.flagged);

/**
 * A message in the thread. `state` is what the beat does with it: `now` is the
 * one that has just arrived and `past` is the one carried over from the beat
 * before, so a message is written once and each beat says how it is read.
 */
interface Message {
  readonly from: 'argus' | 'you';
  readonly says: string;
  /** Who it signs as, when that is not the channel's default: on GitHub Argus
   *  posts as the App installation, and over MCP it is simply Argus. */
  readonly as?: string;
  readonly tag?: { readonly text: string; readonly level: 'medium' | 'high' };
  readonly state?: 'now' | 'past';
  readonly typing?: boolean;
}

/** The three messages the story is made of, so the two beats that repeat one
 *  never drift from the beat that first said it. */
const FINDING: Message = {
  from: 'argus',
  tag: { text: 'medium', level: 'medium' },
  says: 'Broken authorization. The handler returns any order by id, and nothing checks that the caller owns it.',
};

const CORRECTION: Message = {
  from: 'you',
  says: 'argus, our support agents all share one service account. Does that change this?',
};

const ANSWER: Message = {
  from: 'argus',
  tag: { text: 'high', level: 'high' },
  says: 'Then it is worse than I said. One shared account means any agent can read any customer’s order. And I will remember who your agents are.',
};

interface Beat {
  readonly id: string;
  readonly eyebrow: string;
  readonly title: string;
  readonly lede: string;
  readonly claim: string;
  /** The one measurement the project can show, where the claim it measures is
   *  made — and never bigger than the scope it was measured on. */
  readonly note?: string;
  readonly link?: { readonly href: string; readonly label: string };
  readonly code?: typeof CODE;
  readonly messages: readonly Message[];
  readonly remembers?: string;
}

/**
 * Where in the panel's scroll progress each part of the thread takes its turn.
 *
 * Derived rather than written down: a beat showing six lines of code and a beat
 * showing one both have to read as a single continuous arrival, and the only
 * thing that differs is how much room the code took first. Percentages are of
 * the `cover` range — see the stylesheet for why that range and not `entry`.
 */
function stagger(beat: Beat) {
  const afterCode = 22 + (beat.code?.length ?? 0) * 4;

  return {
    line: (index: number) => 16 + index * 4,
    message: (index: number) => afterCode + index * 10,
    remembers: afterCode + beat.messages.length * 10 + 2,
  };
}

const BEATS: readonly Beat[] = [
  {
    id: 'reviews',
    eyebrow: 'The review',
    title: 'It reviews your code.',
    lede: 'Open a pull request and Argus reviews it. No CI to wire up, no job to add. Real scanners run as tools, and it works through what they found.',
    claim: 'It reads the whole tree, not just the diff.',
    note: 'Measured once, on an API built to be vulnerable: it found every broken-authorization flaw in it and reported nothing that was not there. One benchmark, one class of flaw.',
    link: { href: '/guide/channels/github/', label: 'How reviews on GitHub work' },
    code: CODE,
    messages: [{ ...FINDING, state: 'now' }],
  },
  {
    id: 'learns',
    eyebrow: 'Your context',
    title: 'It learns from you.',
    lede: 'Answer on the thread. The exception you already granted, the account four teams share, the reason this one endpoint is different.',
    claim: 'Say it once. Every review after that starts from there.',
    code: ANCHOR,
    messages: [
      { ...FINDING, state: 'past' },
      { ...CORRECTION, state: 'now', typing: true },
    ],
  },
  {
    id: 'answers',
    eyebrow: 'The argument',
    title: 'Argue with it.',
    lede: 'A report is a list. This one answers, moves its own finding when you give it a reason, and says so when you are wrong.',
    claim: 'A colleague, not a toolbox.',
    code: ANCHOR,
    messages: [
      { ...CORRECTION, state: 'past' },
      { ...ANSWER, state: 'now' },
    ],
    remembers: 'support agents share one service account',
  },
];


/**
 * What the page says about its own boundaries, which for a tool that reads a
 * stranger's pull request is the section a security reader actually opens.
 *
 * All three are transcribed from the Guide's own security posture and go no
 * further: each is a promise the code has to keep, so none of them is a sentence
 * this page is free to improve on.
 */
/**
 * The other side of the same protocol: not Argus asking a model, but a tool
 * asking Argus. Which is why the reader is watching their own assistant here —
 * you talk to the thing already open on your machine, and Argus answers through
 * it out of what your organization knows.
 *
 * A different question from the story's on purpose. The Guide's MCP channel says
 * an external AI delegates *a question or a review*, and the review half has had
 * three sections already; this is the question half. Both facts in the answer are
 * things Argus is documented to hold: where your secrets live is a SOUL field,
 * and what a payload carries is a context document.
 */
const CONSULT: readonly Message[] = [
  { from: 'you', says: 'ask argus if we can log the raw webhook body' },
  {
    from: 'argus',
    as: 'argus',
    says: 'Not that one. You told me it carries card numbers, and your secrets live in Vault rather than in logs. Log the event id and reference it.',
  },
];

const GUARDS = [
  {
    title: 'A pull request cannot give orders.',
    detail:
      'The code under review is data. Nothing it contains directs the agent, and nothing it says is written back to what your organization knows.',
  },
  {
    title: 'Scanners never leave the checkout.',
    detail:
      'Review tools read the tree they were pointed at, not the machine Argus runs on.',
  },
  {
    title: 'What it knows stays where it runs.',
    detail:
      'Your identity, memory and context documents never leave your instance, and anything Argus posts in public has to be grounded in the tree it just read.',
  },
];

/** Stamped at build time, so the footer never claims a year that has passed. */
const YEAR = new Date().getFullYear();

/**
 * Who the notice names. Not a legal entity, and it does not need to be: a
 * copyright notice declares authorship rather than creating it, and without a
 * CLA every contributor keeps their own — so the collective form is the one that
 * stays true after the first outside pull request. It is the form Go, Kubernetes
 * and Chromium use for the same reason. The Apache appendix upstream should say
 * this same line.
 *
 * Deliberately not the same string as the data controller a privacy notice has
 * to name: that one must be a person or a company somebody can write to, and
 * authors collectively are neither.
 */
const AUTHORS = 'The Argus Authors';

const canonical = new URL('/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/argus.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta name="twitter:card" content="summary" />

    {
      /**
       * The one script on the page, and the reason ADR 0007 exists: outside
       * Starlight's layout nothing sets `data-theme`, so without this the
       * Landing is dark for every reader — including one who chose light in the
       * Guide two clicks ago. Inline and in the head, because a theme resolved
       * after first paint is a flash of the wrong colours.
       *
       * Deliberately the same expression as Starlight's own ThemeProvider, on
       * the same storage key: Starlight writes `''` for "auto", so an empty
       * string correctly falls through to the operating system's preference.
       */
    }
    <script is:inline>
      const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
      const theme =
        stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="/">
          <Mark class="mark" width="24" />
          <span>Argus</span>
        </a>

        <nav class="nav" aria-label="Sections of this page">
          <a href="#reviews">How it works</a>
          <a href="#trust">Trust</a>
          <a href="#your-ai">Your AI</a>
        </nav>

        <div class="topbar-end">
          <a class="nav-link" href={guideHref}>Docs</a>
          <a class="button button-primary button-sm button-icon" href={REPOSITORY}>
            <GitHubMark size={15} />
            GitHub
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="section hero">
        <span class="rings" aria-hidden="true"></span>
        <span class="sweep" aria-hidden="true"></span>
        <span class="blip blip-1" aria-hidden="true"></span>
        <span class="blip blip-2" aria-hidden="true"></span>
        <span class="blip blip-3" aria-hidden="true"></span>

        <div class="shell hero-inner">
          <p class="badge">
            <span class="badge-dot" aria-hidden="true"></span>
            Open source · Self-hosted · Apache 2.0
          </p>

          <h1 class="hero-title">
            Argus reviews your code. <span class="accented">And learns from you.</span>
          </h1>

          <p class="lede">
            An open-source application security agent that knows your stack, your risk tolerance and
            the exceptions you already granted.
          </p>

          <p class="actions">
            <a class="button button-primary" href={guideHref}>Read the docs</a>
            <a class="button button-icon" href={REPOSITORY}>
              <GitHubMark />
              Argus on GitHub
            </a>
          </p>

          {
            /* No caption: the messages are real text in reading order, so a
               screen reader gets the conversation itself rather than a summary
               of it. */
          }
          <div class="chat">
            <ol class="chat-log">
              {
                CONVERSATION.map(({ who, says }, index) => (
                  <li
                    class:list={[
                      'bubble',
                      `bubble-${index + 1}`,
                      who === 'you' ? 'from-you' : 'from-argus',
                    ]}
                  >
                    {who !== 'you' && (
                      <span class="bubble-mark" aria-hidden="true">
                        <Mark width="16" />
                      </span>
                    )}
                    <span class="bubble-text">{says}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      {
        /* Every other beat turns around and stands on the raised band, so the
           page alternates without any beat having to know where it sits. */
        BEATS.map((beat, beatIndex) => {
          const at = stagger(beat);

          return (
          <section
            class:list={[
              'section',
              'story',
              beatIndex % 2 === 1 && ['story-flip', 'section-raised'],
            ]}
            id={beat.id}
            aria-labelledby={`${beat.id}-heading`}
          >
            <div class="shell story-inner">
              <div class="story-copy">
                <p class="eyebrow reveal">{beat.eyebrow}</p>
                <h2 class="heading reveal" id={`${beat.id}-heading`}>
                  {beat.title}
                </h2>

                <div class="prose reveal">
                  <p>{beat.lede}</p>
                  <p class="claim">{beat.claim}</p>
                  {beat.note && <p class="footnote">{beat.note}</p>}
                  {beat.link && (
                    <p>
                      <a href={beat.link.href}>{beat.link.label}</a>
                    </p>
                  )}
                </div>
              </div>

              {
                /* The panel is the argument's evidence, so it is read in order
                   like everything else: the thread's messages are text, and the
                   code above them is a `<pre>`-equivalent list of numbered
                   lines. Nothing here is an image of a screenshot. */
              }
              <div class="panel reveal">
                <p class="panel-head">
                  <span class="panel-repo">{THREAD.repo}</span>
                  <span class="panel-pr">#{THREAD.pr}</span>
                  {beat.code && <span class="panel-file">{THREAD.file}</span>}
                </p>

                {beat.code && (
                  <ol class="code">
                    {beat.code.map((line, index) => (
                      <li
                        class:list={['code-line', line.flagged && 'flagged']}
                        style={`--at: ${at.line(index)}%`}
                      >
                        <span class="code-at">{line.at}</span>
                        <span class="code-text">{line.text}</span>
                      </li>
                    ))}
                  </ol>
                )}

                <ol class="thread">
                  {beat.messages.map((message, index) => (
                    <li
                      class:list={['message', `message-${message.state}`]}
                      style={`--at: ${at.message(index)}%`}
                    >
                      <p class="message-who">
                        {message.from === 'argus' ? (
                          <>
                            <span class="message-mark" aria-hidden="true">
                              <Mark width="14" />
                            </span>
                            {message.as ?? 'argus[bot]'}
                          </>
                        ) : (
                          (message.as ?? 'you')
                        )}
                        {message.tag && (
                          <span
                            class:list={[
                              'level',
                              message.tag.level === 'high' && 'chip chip-sm',
                            ]}
                          >
                            {message.tag.text}
                          </span>
                        )}
                      </p>
                      <p class="message-says">
                        {message.says}
                        {message.typing && <span class="caret" aria-hidden="true"></span>}
                      </p>
                    </li>
                  ))}
                </ol>

                {beat.remembers && (
                  <p class="remembered" style={`--at: ${at.remembers}%`}>
                    <span class="remembered-label">memory</span>
                    {beat.remembers}
                  </p>
                )}
              </div>
            </div>
          </section>
          );
        })
      }

      {
        /*
         * The reader has just watched Argus read a pull request, which is the
         * moment the question changes: not "does it find things" but "what else
         * does it do while it is in there". For anything that reads a stranger's
         * branch and then writes in public, that is the question that decides
         * whether the rest of the page matters.
         *
         * A benchmark used to stand here. It was one deliberately broken app and
         * one class of flaw, which is a fine thing to have measured and a poor
         * thing to headline: a figure a reader cannot check is an invitation to
         * argue with the figure. These three are checkable — every one of them is
         * a promise in the code, on the page it is documented on.
         */
      }
      <section class="section section-raised" id="trust" aria-labelledby="trust-heading">
        <div class="shell">
          <p class="eyebrow reveal">Trust</p>
          <h2 class="heading reveal" id="trust-heading">It reads your branch. Here is the rest.</h2>

          <ul class="guards">
            {
              GUARDS.map(({ title, detail }) => (
                <li class="guard reveal">
                  <h3 class="guard-title">{title}</h3>
                  <p class="guard-body">{detail}</p>
                </li>
              ))
            }
          </ul>

          <div class="prose reveal guards-note">
            <p>
              Apache 2.0, and it runs on your own infrastructure. Which is the only claim on this
              page that matters: read it, run it on a repository you own, and judge it there.
            </p>
            <p><a href="/guide/channels/github/">What a review is allowed to do</a></p>
          </div>
        </div>
      </section>

      {
        /* Two columns, panel on the left, which is the shape the middle beat has
           — so this alternates against the section under it instead of making a
           third "copy left, thing right" in a row. */
      }
      <section
        class="section story story-flip"
        id="your-tools"
        aria-labelledby="your-tools-heading"
      >
        <div class="shell story-inner">
          <div class="story-copy">
            <p class="eyebrow reveal">Your tools</p>
            <h2 class="heading reveal" id="your-tools-heading">
              Ask it from the AI you already use.
            </h2>

            <div class="prose reveal">
              <p>
                Argus speaks MCP, so the assistant already open on your machine can consult it. It
                hands over the question, Argus answers out of what your organization knows, and the
                answer arrives where you were working.
              </p>
              <p class="claim">Your organization's knowledge never leaves Argus.</p>
            </div>

            <ul class="pills reveal">
              {
                CLIENT_MARKS.map((mark) => (
                  <li class="pill">
                    <VendorLogo mark={mark} size={16} />
                    {mark.title}
                  </li>
                ))
              }
              <li class="pill pill-open">anything that speaks MCP</li>
            </ul>

            <div class="prose reveal pills-note">
              <p class="footnote">
                Examples of clients, not a supported list. The protocol is the contract, and Argus
                certifies nobody's client.
              </p>
              <p><a href="/guide/channels/mcp/">How the MCP channel works</a></p>
            </div>
          </div>

          {
            /* The same panel the story uses, because it is the same kind of
               evidence — only the surface changed, from a pull request to
               whatever editor the reader already has open. */
          }
          <div class="panel reveal">
            <p class="panel-head">
              <span class="panel-mark" aria-hidden="true">
                <VendorLogo mark={CLIENT_MARKS[0]!} size={13} />
              </span>
              <span class="panel-repo">{CLIENT_MARKS[0]!.title}</span>
              <span class="chip chip-sm panel-protocol">mcp</span>
            </p>

            <ol class="thread">
              {
                CONSULT.map((message, index) => (
                  <li class="message message-now" style={`--at: ${26 + index * 12}%`}>
                    <p class="message-who">
                      {message.from === 'argus' && (
                        <span class="message-mark" aria-hidden="true">
                          <Mark width="14" />
                        </span>
                      )}
                      {message.as ?? 'you'}
                    </p>
                    <p class="message-says">{message.says}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="section section-raised" id="your-ai" aria-labelledby="your-ai-heading">
        <div class="shell split">
          <div class="split-main">
            <p class="eyebrow reveal">Your AI</p>
            <h2 class="heading reveal" id="your-ai-heading">Use your own AI.</h2>

            <div class="prose reveal">
              <p>
                Argus ships no model. Point it at whatever speaks the protocol: a hosted API, or
                something running on hardware you own.
              </p>
              <p class="claim">Run it on your own machines and your code never leaves them.</p>
              <p class="footnote">
                Examples of servers that speak it, not a supported list. Argus implements the
                protocol and certifies nobody's server.
              </p>
              <p><a href="/guide/llm-providers/">What Argus needs from a model</a></p>
            </div>
          </div>

          <div class="reel reveal">
            <ul class="reel-column">
              {
                PROVIDER_MARKS.map((mark) => (
                  <li class="reel-item">
                    <VendorLogo mark={mark} />
                    {mark.title}
                  </li>
                ))
              }
            </ul>
            <ul class="reel-column" aria-hidden="true">
              {
                PROVIDER_MARKS.map((mark) => (
                  <li class="reel-item">
                    <VendorLogo mark={mark} />
                    {mark.title}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell footer-inner">
        <div class="footer-brand">
          <p class="brand">
            <Mark class="mark" width="22" />
            <span>Argus</span>
          </p>
          <p class="footer-tagline">
            An open-source application security agent that knows your organization.
          </p>
        </div>

        <nav class="footer-column" aria-label="Documentation">
          <p class="footer-heading">Docs</p>
          <a href={guideHref}>All of it</a>
          {
            /* The first few pages in the Guide's own order, so this stays generated
               from the Mirror's frontmatter without becoming a second sitemap. */
          }
          {pages.slice(0, 3).map((page) => <a href={page.href}>{page.title}</a>)}
        </nav>

        <nav class="footer-column" aria-label="Project">
          <p class="footer-heading">Project</p>
          <a href={REPOSITORY}>GitHub</a>
          <a href={`mailto:${SECURITY_CONTACT}`}>Report a vulnerability</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </div>

      <p class="shell footer-note">
        © {YEAR} {AUTHORS}. Apache 2.0. Built with{' '}
        <span class="heart" aria-hidden="true">♥</span><span class="sr-only">love</span> and Go.
      </p>
    </footer>

    <style>
      /*
       * Starlight's reset ships only on Starlight's own routes, and
       * `@astrojs/starlight-tailwind` restores just borders and font families
       * for pages like this one. So the Landing brings the little else it needs
       * rather than pulling in Tailwind's full preflight, which Starlight's
       * stylesheet is not written to sit under.
       */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-size: 1.0625rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        /* One easing for everything that arrives, so the page moves in one
           handwriting. */
        --enter: cubic-bezier(0.22, 0.68, 0.3, 1);
      }

      h1,
      h2,
      h3,
      p,
      ul,
      ol,
      figure {
        margin: 0;
      }

      ul,
      ol {
        padding: 0;
        list-style: none;
      }

      a {
        color: inherit;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }

      :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skip {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        z-index: 2;
        padding: 0.5rem 0.85rem;
        border-radius: 0.5rem;
        background-color: var(--color-primary);
        color: var(--color-bg);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-250%);
      }

      .skip:focus-visible {
        transform: none;
      }

      /* Layout ---------------------------------------------------------------
       *
       * One shell, one section rhythm. Both are declared once and never
       * re-declared per section: a section modifier may add a background, never
       * a padding, so no two rules in here ever argue about spacing.
       */

      .shell {
        width: 100%;
        max-width: 68rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      }

      .section {
        padding-block: clamp(3.25rem, 7vw, 5.25rem);
        /* The bar is sticky, so an anchor has to stop below it. */
        scroll-margin-top: 4rem;
      }

      .section-raised {
        background-color: var(--color-surface);
        border-block: 1px solid var(--color-border);
      }

      /* Type ----------------------------------------------------------------
       *
       * No brand typeface, deliberately and out of scope, so the page borrows
       * the two voices the brand already has: the banner's heavy tightly
       * tracked wordmark for anything that speaks, and the mono face for
       * anything that labels. A label is a label, a heading is a heading, and
       * they never dress as each other.
       */

      .eyebrow,
      .nav a,
      .badge {
        font-family: var(--font-mono);
      }

      /*
       * Muted, not `primary`, and the reason is a measurement: half the sections
       * stand on `surface`, where verdigris measures 4.31 and fails AA for type
       * this small. `text-muted` reads 5.51 on `bg` and 5.67 on `surface`, so one
       * rule is safe wherever a section puts it. The colour goes where the ground
       * is always `bg`: the headline's second clause and the links.
       */
      .eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      .heading {
        margin-block: 0.85rem 2.25rem;
        max-width: 30ch;
        font-size: clamp(1.6rem, 3.2vw, 2.25rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.12;
        text-wrap: balance;
      }

      .prose {
        display: grid;
        gap: 1rem;
        max-width: 36rem;
      }

      .prose a,
      .footer .brand {
        color: var(--color-text);
        font-size: 1rem;
      }

      .footer a {
        color: var(--color-primary);
      }

      .prose a,
      .footer a,
      .nav a,
      .nav-link {
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        transition: color 0.2s ease;
      }

      .prose a:hover,
      .footer a:hover {
        text-decoration-thickness: 2px;
      }

      /* The bar -------------------------------------------------------------
       *
       * Sticky, and translucent so the rings keep moving underneath it. The
       * section links disappear on a narrow screen: a hamburger is a script,
       * and the page is short enough to scroll.
       */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border);
      }

      /* The mark holds the left; everything you can click gathers on the right.
         `auto` before the section links is what pushes the whole group over, and
         it keeps working when the links drop away on a narrow screen. */
      .topbar-inner {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        min-height: 3.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1.0625rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-decoration: none;
      }

      .mark {
        display: block;
        height: auto;
      }

      .nav {
        display: none;
        gap: 1.5rem;
        margin-left: auto;
        font-size: 0.8125rem;
      }

      .nav a,
      .nav-link {
        color: var(--color-text-muted);
        text-decoration: none;
      }

      .nav a:hover,
      .nav-link:hover {
        color: var(--color-text);
      }

      .nav-link {
        font-size: 0.875rem;
        font-weight: 600;
      }

      .topbar-end {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: auto;
      }

      @media (min-width: 52rem) {
        .nav {
          display: flex;
        }

        .topbar-end {
          margin-left: 0;
        }
      }

      /* Hero ----------------------------------------------------------------
       *
       * The rings are the page's atmosphere: concentric hairlines centred where
       * the eye of the mark would be, dilating like an iris. They are drawn in
       * CSS rather than taken from the artwork, so a redrawn mark cannot break
       * them, and they are masked to nothing before they reach the edges so the
       * pattern never reads as a grid.
       */

      /* The one section that closes with a rule rather than with a change of
         ground: every other boundary on the page is a band swap, and the story's
         first beat stands on the same `bg` the hero does. */
      .hero {
        position: relative;
        overflow: clip;
        padding-top: clamp(2.5rem, 6vw, 4.5rem);
        border-bottom: 1px solid var(--color-border);
        text-align: center;
      }

      .rings {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-radial-gradient(
          circle at 50% 30%,
          color-mix(in srgb, var(--color-accent) 18%, transparent) 0 1.5px,
          transparent 1.5px 74px
        );
        mask-image: radial-gradient(circle at 50% 30%, black 8%, transparent 62%);
        transform-origin: 50% 30%;
      }

      /*
       * The eye looking: a ring that leaves the centre at a constant rate and
       * fades as it goes. Constant, because the marks below are timed off it —
       * the whole point is that a mark answers when the front reaches it, and an
       * eased front arrives somewhere else. Invisible at rest, which is what
       * makes it safe to switch off: a reader who asks for less motion loses a
       * decoration rather than gaining a stray circle.
       */
      .sweep {
        position: absolute;
        left: 50%;
        top: 30%;
        width: 13rem;
        height: 13rem;
        margin: -6.5rem 0 0 -6.5rem;
        border: 1.5px solid color-mix(in srgb, var(--color-accent) 62%, transparent);
        border-radius: 50%;
        box-shadow:
          0 0 1.4rem color-mix(in srgb, var(--color-accent) 20%, transparent),
          inset 0 0 1.4rem color-mix(in srgb, var(--color-accent) 12%, transparent);
        opacity: 0;
        pointer-events: none;
      }

      /*
       * What the sweep finds. A sonar that never returns anything is a
       * decoration; these answer as the front reaches them, nearest first, which
       * is the argument of the page in the smallest form it has: something is
       * looking, and it is finding things.
       *
       * Each one sits at a fixed `rem` offset from the sweep's own centre, which
       * is what makes the timing hold at every viewport: the front's radius grows
       * in `rem` too, so the distance between them never depends on how tall the
       * hero happens to be.
       *
       * `--hit` is therefore computed, not chosen. The front leaves at 2.6rem and
       * reaches 26rem in seven seconds, so a mark at radius r answers at
       * 7 × (r − 2.6) / 23.4, plus the sweep's own delay, minus the 5% the flash
       * sits at inside its own cycle. Move a mark, or change the sweep's scale,
       * and recompute every `--hit` — otherwise the sonar goes back to guessing.
       *
       * Ahead of `.hero-inner` in the document and unpositioned in the stack, so
       * they can never land on top of the words.
       */
      .blip {
        position: absolute;
        width: 0.45rem;
        height: 0.45rem;
        /* Half its own size back, so `left` and `top` place its centre — the
           transform belongs to the flash and cannot be spent on positioning. */
        margin: -0.225rem 0 0 -0.225rem;
        border-radius: 50%;
        background-color: var(--color-accent);
        opacity: 0;
        pointer-events: none;
      }

      /* The return: a ring leaving the mark, the way an echo leaves the thing it
         bounced off. */
      .blip::after {
        content: '';
        position: absolute;
        inset: -0.3rem;
        border: 1px solid color-mix(in srgb, var(--color-accent) 65%, transparent);
        border-radius: 50%;
        opacity: 0;
      }

      /* Above the badge. r = 16.22rem, reached 4.08s in: the first to answer. */
      .blip-1 {
        --hit: 6.13s;
        left: calc(50% - 9rem);
        top: calc(30% - 13.5rem);
      }

      /* Clear of the headline's right edge. r = 24.08rem, reached 6.42s in. */
      .blip-2 {
        --hit: 1.47s;
        left: calc(50% + 24rem);
        top: calc(30% + 2rem);
      }

      /* Beside the conversation. r = 25rem, reached 6.7s in: the last. */
      .blip-3 {
        --hit: 1.75s;
        left: calc(50% - 20rem);
        top: calc(30% + 15rem);
      }

      .hero-inner {
        position: relative;
        display: grid;
        justify-items: center;
        gap: 1.35rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.8rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
        color: var(--color-text-muted);
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* The one gold dot on the page: the eye, at label size. */
      .badge-dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background-color: var(--color-accent);
      }

      .hero-title {
        max-width: 20ch;
        font-size: clamp(2.4rem, 6.4vw, 4.25rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1;
        text-wrap: balance;
      }

      /* `primary` on `bg`, which is a pair the build asserts: 5.68 on paper,
         4.95 on night. The claim gets the colour, not the whole headline. */
      .accented {
        color: var(--color-primary);
      }

      .lede {
        max-width: 38rem;
        font-size: clamp(1.0625rem, 2vw, 1.1875rem);
        color: var(--color-text-muted);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      /* Buttons -------------------------------------------------------------
       *
       * The filled one is `bg` over `primary`, one of the pairs ADR 0004
       * measured and the build asserts, so the loudest element on the page is
       * also one of the checked ones.
       */

      .button {
        display: inline-block;
        padding: 0.7rem 1.2rem;
        border: 1px solid var(--color-border);
        border-radius: 0.6rem;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        transition:
          border-color 0.2s ease,
          background-color 0.2s ease,
          color 0.2s ease;
      }

      .button:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      .button-primary {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-bg);
      }

      .button-primary:hover {
        background-color: color-mix(in oklab, var(--color-primary) 88%, var(--color-text));
        border-color: color-mix(in oklab, var(--color-primary) 88%, var(--color-text));
        color: var(--color-bg);
      }

      .button-sm {
        padding: 0.4rem 0.85rem;
        font-size: 0.8125rem;
      }

      .button-icon {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }

      /* The conversation ----------------------------------------------------
       *
       * The hero's signature: the thing a scanner cannot do is know why a
       * finding matters here. Set as a chat, because that is the claim.
       *
       * Your side is a `primary` fill with `bg` over it, which is a pair the
       * build asserts. Argus answers on `bg` inside the `surface` card, so its
       * side never needs a colour that would fail there.
       */

      .chat {
        width: 100%;
        max-width: 38rem;
        margin-top: 1.25rem;
        padding: 1.25rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        text-align: left;
        box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--color-bg) 55%, transparent);
      }

      .chat-log {
        display: grid;
        gap: 0.6rem;
        font-size: 0.9375rem;
        line-height: 1.5;
      }

      .bubble {
        display: flex;
        align-items: flex-end;
        gap: 0.45rem;
        max-width: 88%;
      }

      .bubble-text {
        padding: 0.5rem 0.75rem;
        border-radius: 1rem;
      }

      .from-you {
        justify-self: end;
        flex-direction: row-reverse;
      }

      .from-you .bubble-text {
        background-color: var(--color-primary);
        border-bottom-right-radius: 0.3rem;
        color: var(--color-bg);
      }

      .from-argus .bubble-text {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-bottom-left-radius: 0.3rem;
      }

      /* The mark sits where a chat puts an avatar, at the size the brand's own
         README gives as its floor for the mark alone. */
      .bubble-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: 1.7rem;
        height: 1.7rem;
        margin-bottom: 0.1rem;
        border: 1px solid var(--color-border);
        border-radius: 50%;
        background-color: var(--color-bg);
      }


      /* The story -----------------------------------------------------------
       *
       * Three beats, alternating sides, and one thread running through all
       * three. The copy states the claim; the panel beside it is the claim
       * happening. Which is why the panel is never an image: it is text in
       * reading order, so the argument survives a screen reader, a text-only
       * browser and a reader who turns motion off.
       *
       * On a narrow screen the copy always comes first and the panel follows,
       * whichever side the beat sits on when there is room for two.
       *
       * These three rules are the page's two-column recipe rather than the
       * story's alone: the tools section borrows them, because it is the same
       * arrangement of the same two things.
       */

      .story-inner {
        display: grid;
        gap: 2rem;
      }

      @media (min-width: 58rem) {
        .story-inner {
          grid-template-columns: 0.95fr 1.05fr;
          gap: 3.5rem;
          align-items: center;
        }

        .story-flip .story-copy {
          order: 2;
        }
      }

      .story .heading {
        margin-bottom: 1.5rem;
      }

      /* The panel -----------------------------------------------------------
       *
       * A window on the thread, in the same two neutrals as everything else:
       * `surface` on the plain band, `bg` on the raised one. Nothing in here
       * invents a third grey, and the cards inside take whichever of the two the
       * panel did not.
       */

      .panel {
        padding: 0.9rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--color-bg) 45%, transparent);
      }

      /* Written out rather than routed through a local custom property: the
         Landing's rule is that you can read the Token at the point of paint, and
         a `var(--panel-ground)` would only tell you where to look next. */
      .section-raised .panel {
        background-color: var(--color-bg);
      }

      .panel-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        padding: 0.15rem 0.35rem 0.75rem;
        border-bottom: 1px solid var(--color-border);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-muted);
      }

      .panel-repo {
        color: var(--color-text);
        font-weight: 600;
      }

      /* The client's own mark, at the size the head's type is, so the panel says
         whose window this is the way a window would. */
      .panel-mark {
        display: inline-flex;
        align-items: center;
        flex: none;
      }

      /* Gold, and the far end of the head: the protocol is what the panel is
         about, the way the file path is what the review panel is about. */
      .panel-protocol {
        margin-left: auto;
      }

      /* The file sits at the far end, and is the first thing to go when the
         panel is narrow: the repository and the number are what locate you. */
      .panel-file {
        margin-left: auto;
      }

      .code {
        display: grid;
        gap: 0.1rem;
        padding: 0.75rem 0 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.75;
      }

      /* The gutter is reserved on every line and painted on one, so the flagged
         line does not shift the code sideways by two pixels. Width and style
         only: the line that has a colour is the line that names a Token. */
      .code-line {
        display: flex;
        gap: 0.75rem;
        padding-left: 0.35rem;
        /* A line of code is one line: it never wraps, and the panel gives it
           room rather than the page giving it a sideways scrollbar. */
        white-space: pre;
        border-left-width: 2px;
        border-left-style: solid;
        border-left-color: transparent;
      }

      .code-at {
        flex: none;
        width: 1.5rem;
        text-align: right;
        color: var(--color-text-muted);
      }

      /*
       * The line the finding is about. Gold as a rule and as a wash, never as
       * type — the same shape ADR 0004 gives it everywhere else on the page,
       * because at this size on paper the colour cannot carry a letter.
       */
      .flagged {
        border-left-color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 9%, transparent);
      }

      /* The thread ----------------------------------------------------------
       *
       * The message that has just arrived is a card; the one carried over from
       * the beat before is the same box with no fill and muted type, which reads
       * as history without ever going under AA.
       */

      .thread {
        display: grid;
        gap: 0.6rem;
        padding-top: 0.75rem;
      }

      .message {
        padding: 0.7rem 0.85rem;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 0.7rem;
        font-size: 0.9375rem;
        line-height: 1.5;
      }

      /* Whichever of the two neutrals the panel did not take. */
      .section-raised .message {
        background-color: var(--color-surface);
      }

      .message-past {
        background-color: transparent;
        color: var(--color-text-muted);
      }

      .message-who {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-muted);
      }

      .message-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 50%;
      }

      /* Medium is a label; high is the gold chip. So the one thing that changes
         because you spoke up is the one thing that changes colour. */
      .level {
        margin-left: auto;
        padding: 0.05rem 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 0.35rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .level.chip {
        margin-left: auto;
      }

      /* Still being typed, which is the one thing on this half of the page that
         moves on its own clock rather than on the reader's scrolling. */
      .caret {
        display: inline-block;
        width: 0.45rem;
        height: 0.9rem;
        margin-left: 0.15rem;
        vertical-align: text-bottom;
        background-color: var(--color-primary);
      }

      /* What stuck. The story's last line, and the only place the page names a
         piece of the machinery: MEMORY is why "say it once" is a claim and not a
         wish. */
      .remembered {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
        padding: 0.35rem 0.35rem 0.1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-text-muted);
      }

      .remembered-label {
        padding: 0.05rem 0.45rem;
        border-radius: 0.35rem;
        background-color: color-mix(in srgb, var(--color-accent) 16%, transparent);
        color: var(--color-text);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      /*
       * Gold as a rule rather than as type: on paper it is unreadable as a
       * foreground at 1.76, and a 2px band is the shape ADR 0004 gives it there.
       */
      .claim {
        padding-left: 1rem;
        border-left: 2px solid var(--color-accent);
        font-size: clamp(1.0625rem, 2vw, 1.15rem);
        font-weight: 600;
      }

      /* The chip is the other gold shape: a fill, with night over it in either
         theme. `text` is night in light and `bg` is night in dark, which is the
         asymmetry `::selection` in the Token layer already follows. */
      .chip {
        display: inline-block;
        padding: 0.45rem 0.9rem;
        border-radius: 0.5rem;
        background-color: var(--color-accent);
        color: var(--color-bg);
        font-weight: 700;
      }

      :root[data-theme='light'] .chip {
        color: var(--color-text);
      }

      .chip-sm {
        padding: 0.1rem 0.5rem;
        border-radius: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
      }

      /* Your AI -------------------------------------------------------------
       *
       * Two columns: the argument on one side, the marks on the other, travelling
       * up their own column. Moving, because a list that scrolls reads as an open
       * set while a fixed grid of marks reads as a closed one — and the whole
       * distinction here is that these speak a protocol rather than being blessed
       * by anybody.
       *
       * The column is duplicated and travels exactly its own height, so the loop
       * has no seam. The copy is hidden from assistive technology, which gets the
       * names once.
       */

      .split {
        display: grid;
        gap: 2.5rem;
      }

      @media (min-width: 52rem) {
        .split {
          grid-template-columns: 1fr 15rem;
          gap: 4rem;
          align-items: center;
        }
      }

      .reel {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 17rem;
        overflow: hidden;
        mask-image: linear-gradient(transparent, black 18%, black 82%, transparent);
      }

      .reel-column {
        display: grid;
        flex: none;
        gap: 0.5rem;
        padding-bottom: 0.5rem;
      }

      .reel-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.8rem;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        white-space: nowrap;
      }

      .footnote {
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }

      /* Trust ---------------------------------------------------------------
       *
       * On the raised band the boxes are `bg`: the same two neutrals as
       * everywhere else, swapped, so a box stays visible against the band
       * without inventing a third grey. Titles are `text` and bodies are
       * `text-muted` — a promise is not a place for a colour.
       */

      .guards {
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 52rem) {
        .guards {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .guard {
        padding: 1.35rem;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 0.9rem;
      }

      .guard-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }

      .guard-body {
        margin-top: 0.5rem;
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      .guards-note {
        margin-top: 2rem;
      }

      /* Your tools ----------------------------------------------------------
       *
       * Names rather than marks, and the last one is not a name at all: the
       * point of a protocol is that the list is open, so the row ends with the
       * rule instead of with a product. Dashed, because a dashed border is how a
       * set says "and the rest" without claiming to know what the rest is.
       */

      .pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.75rem;
      }

      .pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.8rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
      }

      .section-raised .pill {
        background-color: var(--color-bg);
      }

      .pill-open {
        background-color: transparent;
        border-style: dashed;
      }

      .pills-note {
        margin-top: 1.75rem;
      }


      /* Footer ---------------------------------------------------------------
       *
       * Three blocks and a line: who this is, what there is to read, and where
       * the project lives. The reading column is generated from the Mirror's
       * frontmatter, so a page added upstream arrives here on its own — the same
       * guarantee the section that used to sit above the footer had, at a
       * fraction of the room.
       */

      .footer {
        padding-block: 2.75rem 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.9375rem;
        color: var(--color-text-muted);
      }

      .footer-inner {
        display: grid;
        gap: 2.25rem;
      }

      @media (min-width: 46rem) {
        .footer-inner {
          grid-template-columns: 1fr auto auto;
          gap: 3.5rem;
        }
      }

      .footer-brand {
        max-width: 22rem;
      }

      .footer-tagline {
        margin-top: 0.6rem;
      }

      .footer-column {
        display: grid;
        gap: 0.45rem;
        align-content: start;
      }

      .footer-heading {
        margin-bottom: 0.2rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text);
      }

      .footer-note {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
      }

      /* Gold, and the same two beats as the badge: the page has one pulse. */
      .heart {
        display: inline-block;
        color: var(--color-accent);
      }

      /* Motion --------------------------------------------------------------
       *
       * Every animation lives inside this one query, and the page's resting
       * state is the finished state. So a reader who asks for less motion is not
       * served a blank page, and neither is a browser without scroll-driven
       * animations: they both get the page with nothing moving.
       */

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }

        .hero-inner > * {
          animation: rise 0.7s cubic-bezier(0.22, 0.68, 0.3, 1) both;
        }

        .hero-title {
          animation-delay: 0.08s;
        }

        .lede {
          animation-delay: 0.18s;
        }

        .actions {
          animation-delay: 0.28s;
        }

        /* The card lands last and from further away: it is the one thing on the
           page worth waiting a third of a second for. */
        .chat {
          animation: settle 0.9s 0.38s cubic-bezier(0.22, 0.68, 0.3, 1) both;
        }

        /*
         * The conversation replays: each message arrives in turn, the four hold
         * long enough to be read twice, then the log clears and it starts again.
         *
         * Four sets of keyframes rather than one set and four delays, which is
         * the shorter way to write it and the wrong one: with delays, every
         * bubble also *clears* on its own offset, so the log empties raggedly
         * instead of at once. Same duration and no delay anywhere means all four
         * share one clock, and the percentages say when each speaks.
         */
        .bubble {
          animation: 15s var(--enter) infinite both;
        }

        .bubble-1 {
          animation-name: says-1;
        }

        .bubble-2 {
          animation-name: says-2;
        }

        .bubble-3 {
          animation-name: says-3;
        }

        .bubble-4 {
          animation-name: says-4;
        }

        .blip {
          animation: blip 7s var(--hit) ease-out infinite;
        }

        .blip::after {
          animation: echo 7s var(--hit) ease-out infinite;
        }

        .sweep {
          animation: sweep 7s 2.4s linear infinite;
        }

        .reel-column {
          animation: travel 26s linear infinite;
        }

        /* Two beats and a rest, at rest-heart-rate. The one gold dot on the page
           is also the only thing on it that is alive. */
        .badge-dot,
        .heart {
          animation: beat 2.6s ease-in-out infinite;
        }

        /* The iris: out once on arrival, then a slow dilation that never
           finishes. Slow enough that it reads as light rather than as movement. */
        .rings {
          animation:
            iris 2.2s cubic-bezier(0.22, 0.68, 0.3, 1) both,
            dilate 19s 2.2s ease-in-out infinite alternate;
        }

        /* One block, blinking, at about the rate a terminal does. */
        .caret {
          animation: blink 1.1s steps(2, jump-none) infinite;
        }

        /*
         * Scroll-driven, so each element arrives on its own as it enters —
         * a stagger the page gets from the reader's scrolling rather than from a
         * table of delays. A browser without scroll-driven animations skips the
         * block and shows the page, which is the resting state anyway.
         *
         * Longhands, and not the `animation` shorthand: the build minifies with
         * Lightning CSS, which folds `animation-timeline` into a shorthand in
         * the same rule and emits `animation: 1s linear both rise view()` — and
         * the timeline was removed from that shorthand, so the whole declaration
         * is invalid and dropped. Chrome agrees: `CSS.supports('animation', '1s
         * linear both rise view()')` is false. The symptom is no reveal at all,
         * in every browser, with nothing in the build to say so.
         */
        @supports (animation-timeline: view()) {
          .reveal {
            animation-name: rise;
            animation-duration: 1s;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 6% entry 55%;
          }

          /*
           * The story assembles as you scroll it: the code arrives line by line
           * and then the message lands, which is the same order it happened in.
           *
           * All of it is driven by the panel's own timeline rather than each
           * element's, and that is the whole trick. A line of code is 21px tall,
           * so its own range would be 21px of scrolling — a snap, not an arrival.
           * Keyed to the panel, every part of the thread reads one progress, and
           * `--at` is where in it each one takes its turn.
           *
           * Over `cover` rather than `entry`: `entry` ends the moment the panel
           * is fully on screen, which for a panel this size is about 300px of
           * scrolling for the whole thread. `cover` spans the panel crossing the
           * whole viewport, so the story assembles over roughly half a screen —
           * about 500px, measured — which is a pace you can watch.
           */
          .panel {
            view-timeline-name: --panel;
          }

          .code-line,
          .message-now,
          .remembered {
            animation-name: land;
            animation-duration: 1s;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: --panel;
            animation-range: cover var(--at) cover calc(var(--at) + 14%);
          }
        }
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(1rem);
        }
      }

      @keyframes settle {
        from {
          opacity: 0;
          transform: translateY(2.25rem) scale(0.985);
        }
      }

      /* Arriving in a thread: from slightly below, and slightly small, the way a
         message that was just posted looks the instant before it settles. */
      @keyframes land {
        from {
          opacity: 0;
          transform: translateY(0.6rem) scale(0.98);
        }
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      @keyframes iris {
        from {
          opacity: 0;
          transform: scale(0.55);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @keyframes dilate {
        to {
          transform: scale(1.07);
        }
      }


      /*
       * One message arriving, at four moments in the same fifteen seconds. The
       * `to` of each is where the bubble rests, so the page with no motion is the
       * page with all four messages in place.
       */
      @keyframes says-1 {
        0%,
        2% {
          opacity: 0;
          transform: translateY(0.5rem);
        }
        6%,
        90% {
          opacity: 1;
          transform: none;
        }
        95%,
        100% {
          opacity: 0;
        }
      }

      @keyframes says-2 {
        0%,
        18% {
          opacity: 0;
          transform: translateY(0.5rem);
        }
        23%,
        90% {
          opacity: 1;
          transform: none;
        }
        95%,
        100% {
          opacity: 0;
        }
      }

      @keyframes says-3 {
        0%,
        46% {
          opacity: 0;
          transform: translateY(0.5rem);
        }
        50%,
        90% {
          opacity: 1;
          transform: none;
        }
        95%,
        100% {
          opacity: 0;
        }
      }

      @keyframes says-4 {
        0%,
        62% {
          opacity: 0;
          transform: translateY(0.5rem);
        }
        67%,
        90% {
          opacity: 1;
          transform: none;
        }
        95%,
        100% {
          opacity: 0;
        }
      }

      @keyframes sweep {
        from {
          opacity: 0;
          transform: scale(0.4);
        }
        7% {
          opacity: 0.95;
        }
        80% {
          opacity: 0.75;
        }
        96% {
          opacity: 0.55;
        }
        to {
          opacity: 0;
          transform: scale(4);
        }
      }

      /* Struck, then settling: a hard flash on contact, a moment of holding, and
         gone before the next front leaves the centre. */
      @keyframes travel {
        to {
          transform: translateY(-100%);
        }
      }

      @keyframes blip {
        0%,
        4% {
          opacity: 0;
          transform: scale(0.4);
        }
        5% {
          opacity: 1;
          transform: scale(2.6);
        }
        9% {
          opacity: 1;
          transform: scale(1);
        }
        26% {
          opacity: 0.9;
        }
        46%,
        100% {
          opacity: 0;
        }
      }

      @keyframes echo {
        0%,
        4% {
          opacity: 0;
          transform: scale(0.6);
        }
        6% {
          opacity: 0.9;
        }
        24%,
        100% {
          opacity: 0;
          transform: scale(2.8);
        }
      }

      @keyframes beat {
        0%,
        26%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
        }
        8% {
          transform: scale(1.55);
          box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--color-accent) 0%, transparent);
        }
        17% {
          transform: scale(1.28);
        }
      }
    </style>
  </body>
</html>
